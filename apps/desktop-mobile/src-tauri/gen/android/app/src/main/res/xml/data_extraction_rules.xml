<?xml version="1.0" encoding="utf-8"?>
<!-- The device identity must not be cloned onto another phone through cloud backup or device transfer
     (M4-02): nothing of the app's private data is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
