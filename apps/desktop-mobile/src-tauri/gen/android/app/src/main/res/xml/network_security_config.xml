<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this phone's own loopback address: the app serves video originals to its
     WebView from 127.0.0.1 (src-tauri/src/media.rs). Everything else needs TLS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
