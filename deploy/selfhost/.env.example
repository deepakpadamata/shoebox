# Copy to .env and fill in. Every setting is also a command-line flag (`shoebox-cloud --help`).

# The public name of the service; links look like https://<this>/a#...  (Caddy gets its certificate.)
SHOEBOX_DOMAIN=photos.example.org

# Per library, GiB (default 2), and what one shared link may serve a day, GiB (default 1).
#SHOEBOX_QUOTA_GIB=2
#SHOEBOX_SHARE_DAILY_GIB=1

# Only libraries already registered may use the service (a family's own server: open it, back up, then close).
#SHOEBOX_CLOSED=true

# The operator's token for /admin (reported links). Make a long random one: openssl rand -hex 32
#SHOEBOX_ADMIN_TOKEN=

# Keep the bytes in an S3-compatible bucket instead of the data volume (R2, B2, S3, MinIO...). The bucket needs a
# CORS rule letting https://<SHOEBOX_DOMAIN> GET and HEAD (docs/notes/cloud-deploy.md).
#SHOEBOX_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#SHOEBOX_S3_BUCKET=shoebox
#SHOEBOX_S3_REGION=auto
#SHOEBOX_S3_ACCESS_KEY_ID=
#SHOEBOX_S3_SECRET_ACCESS_KEY=
# Address the bucket as https://<bucket>.<endpoint host> rather than https://<endpoint host>/<bucket>.
#SHOEBOX_S3_VIRTUAL_HOST=true
